{
  "name": "Ember",
  "short_name": "Ember",
  "description": "Guitar practice helper with voice commands",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0705",
  "theme_color": "#0d0705",
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "img/ember.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
